# Copy to .env and fill in. Loaded automatically by `research-gap-agent` and `streamlit run app.py`.
# Lines starting with # are comments. Do not commit .env.

# ---------------------------------------------------------------------------
# LLM provider. Set ONE provider's key; the agent auto-detects it. RGA_LLM_PROVIDER forces a choice:
#   anthropic | openai | azure | gemini | mistral | groq | together | openrouter | deepseek | xai |
#   ollama | lmstudio | openai-compatible
# RGA_LLM_PROVIDER=anthropic
# RGA_LLM_MODEL=                 # model id; blank = the provider's default (see research_gap_agent/providers.py)
# RGA_LLM_BASE_URL=              # only for self-hosted / openai-compatible servers, e.g. http://localhost:8000/v1
# RGA_LLM_API_KEY=               # key for openai-compatible servers
# RGA_LLM_REASONING_EFFORT=0     # 1 to send reasoning_effort to non-OpenAI providers that accept it

# Anthropic. Max/Ultra/Team subscribers: link a Console org in claude.ai > Settings > Billing,
# then create the key at platform.claude.com > API Keys (spends the plan's monthly API credits).
ANTHROPIC_API_KEY=sk-ant-api03-...

# Only if the API returns "This API key is not scoped to a workspace": the workspace to bill, from
# platform.claude.com > Settings > Workspaces > open the workspace > ID (wrkspc_...). Alternatively create a key
# scoped to a workspace and leave this blank.
ANTHROPIC_WORKSPACE_ID=

# Other providers (fill the one you use)
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=        AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/   AZURE_OPENAI_API_VERSION=2024-10-21
# GEMINI_API_KEY=              (GOOGLE_API_KEY also accepted)
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# Ollama / LM Studio need no key: RGA_LLM_PROVIDER=ollama and RGA_LLM_MODEL=<model you pulled>

# ---------------------------------------------------------------------------
# Academic sources
# Recommended: your email for the OpenAlex/Crossref polite pools and Unpaywall full-text lookups.
RGA_MAILTO=you@example.org

# Recommended: OpenAlex meters unauthenticated requests against a free daily budget shared by your network IP;
# with your own free key (https://help.openalex.org/api/authentication/) you get your own budget.
OPENALEX_API_KEY=

# Optional: Semantic Scholar is heavily rate-limited without a key (free: https://www.semanticscholar.org/product/api)
S2_API_KEY=

# Optional: enables the google_scholar source through SerpAPI (paid)
SERPAPI_KEY=

# Optional: higher PubMed rate limit
NCBI_API_KEY=

# Optional overrides
# RGA_MODEL=claude-opus-5-5
# RGA_RUNS_DIR=runs
# RGA_CACHE_DIR=.api_cache

# Optional: GitHub repository search (the github source) works without a token at 10 requests/minute; a token allows 30
GITHUB_TOKEN=
